diff --git a/cu_avr.c b/cu_avr.c
index 469a8af..323eb22 100644
--- a/cu_avr.c
+++ b/cu_avr.c
@@ -879,8 +879,18 @@ static void cu_avr_hwexec(void)
 /*
 ** Enters requested interrupt (event_it_enter must be true)
 */
+auint prof_irq_vect = 0xFFFFU;   /* PROFILING HOOK: vector of an IT entered during the last exec */
+auint prof_irq_cycle;            /* PROFILING HOOK: cycle when that IT entry started */
+void (*prof_hook)(auint pc, auint c0, auint c1) = 0;
+#define PROF_EXEC() do { if (prof_hook){ auint p0_ = cpu_state.pc, c0_ = cpu_state.cycle; \
+   prof_irq_vect = 0xFFFFU; cu_avr_exec(); prof_hook(p0_, c0_, cpu_state.cycle); } \
+   else { cu_avr_exec(); } } while (0)
+
 static void cu_avr_interrupt(void)
 {
+ prof_irq_vect  = event_it_vect;
+ prof_irq_cycle = cpu_state.cycle;
+
  auint tmp;
 
  event_it_enter = FALSE; /* Requested IT entry performed */
@@ -2015,7 +2025,7 @@ auint cu_avr_run(void)
    if (source_op == 0x41U && ((cpu_code[profile_pc] >> 16) & 0xFFFFU) == 0U){ source_op = 0U; }
    debug_instruction_pc=profile_pc;
    DIAG_CALL(diagnostics_instruction(profile_pc));
-   cu_avr_exec();       /* Note: This inlines as only this single call exists */
+   PROF_EXEC();         /* (profiling hook when set) */
    if(diagnostics_gate && diagnostics_pending()){ ret |= CU_BREAK; break; }
    if (cu_debug_source_step_active && cu_debug_source_step_tick(cpu_state.pc & 0x7FFFU, source_op)){
     ret |= CU_BREAK;
@@ -2046,7 +2056,7 @@ auint cu_avr_run(void)
 #endif
   }
 #else
-  cu_avr_exec();       /* Note: This inlines as only this single call exists */
+  PROF_EXEC();         /* (profiling hook when set) */
 #endif
